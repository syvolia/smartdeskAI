# --- App ---
APP_NAME=SmartDesk AI
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- CORS (JSON array) ---
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=smartdesk
POSTGRES_PASSWORD=smartdesk
POSTGRES_DB=smartdesk

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Auth ---
# NEVER use this value outside local development. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI ---
# Leave empty to fall back to the built-in mock provider (safe for local dev).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
AI_PROVIDER=auto

# --- Embeddings & RAG ---
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_PROVIDER=auto

KNOWLEDGE_CHUNK_TARGET_TOKENS=400
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=60
KNOWLEDGE_SEARCH_DEFAULT_TOP_K=5
KNOWLEDGE_SEARCH_MIN_SIMILARITY=0.2
KNOWLEDGE_RAG_MIN_SIMILARITY=0.25