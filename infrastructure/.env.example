# Host-side port bindings for the local dev stack.
# Change these if a port is already in use on your machine
# (e.g. a local PostgreSQL or Redis install).
#
# These only affect the HOST side of the mapping.
# Inside the Docker network, containers always talk to each other on the
# native ports (Postgres 5432, Redis 6379).

POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000